{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2023"],
    "strict": true, "noEmit": true, "skipLibCheck": true, "isolatedModules": true,
    "allowImportingTsExtensions": true, "erasableSyntaxOnly": true, "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src", "scripts", "tests"]
}
